# Copy this file to .env and fill in your key. Never commit .env.

# Meta Model API
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
CHAT_PATH=/chat/completions
# auto | openai | anthropic. auto tries chat completions, then the Messages API.
API_STYLE=auto
MESSAGES_PATH=/messages
MAX_TOKENS=8192
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
SAM_MODEL=sam-3.1

# Leave blank to skip; dropped automatically if the API rejects them.
CHECK_EFFORT=low
PLAN_EFFORT=medium
LIVE_EFFORT=minimal
JSON_MODE=false

# 1 = canned answers, no API calls. Defaults to 1 when MODEL_API_KEY is empty.
APPRENTICE_MOCK=

# Where part finding runs: spark | sam_api | sam_local | sam_remote
VISION_BACKEND=spark
# For sam_api: the SAM 3.1 path on the Meta Model API (check the docs; see README).
SAM_API_PATH=/segment
# For sam_remote: your private GPU server running backend/scripts/vision_server.py
SAM_REMOTE_URL=
# For sam_local / vision_server.py: path to the SAM 3.1 checkpoint (optional).
SAM_CHECKPOINT=

MIN_CONFIDENCE=0.6
MAX_IMAGE_SIDE=1280
MAX_VISION_PAGES=24

# Address QR codes point to, e.g. an https tunnel (https://xyz.trycloudflare.com). Empty: this PC's Wi-Fi address.
PUBLIC_URL=

# ---- Hosting for many users (see DEPLOY.md). Leave empty on one PC.
# DATABASE_URL=postgresql://showme:secret@db:5432/showme
# MULTI_USER=1            # workspaces + sign-in; on by default with DATABASE_URL
# ALLOW_SIGNUP=1          # 0 = only existing accounts can create workspaces
# RUN_WORKER=1            # 0 when separate worker processes run `python -m apprentice.worker`
# WORKER_CONCURRENCY=3
# RATE_PER_MINUTE=30      # model-calling requests per person per minute
# LIVE_RATE_PER_MINUTE=90 # live camera frames per person per minute
# UPLOADS_PER_HOUR=20     # manuals and store links per person per hour
